# Vorlage für docker-compose.yaml: nach .env kopieren und anpassen.
# Alle Variablen des Backends stehen in der README unter "Konfiguration des Backends".

# Image-Tag und Port auf dem Host
KINTURA_VERSION=latest
KINTURA_PORT=8080

# Datenbank. Das Passwort vor dem ersten Start ändern, danach bleibt es im Volume gespeichert.
POSTGRES_USER=kintura
POSTGRES_PASSWORD=bitte-aendern
POSTGRES_DB=kintura

# Adresse, unter der Kintura von außen erreichbar ist, für Links in Mails und Downloads
APP_URL=http://localhost:8080
CORS_ORIGIN=*

# Token des Admin-Dashboards, mindestens 16 Zeichen, etwa aus: openssl rand -hex 24
ADMIN_API_KEY=

# Zeitzone neuer Termine
DEFAULT_TIMEZONE=Europe/Berlin

# Mailserver. Ohne SMTP_HOST landen Mails samt Login-Codes nur im Log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Dateiablage: local (Standard, in DATA_DIR/files) oder s3. Der Bucket muss existieren
# und braucht keinen öffentlichen Zugriff, Dateien laufen immer durch das Backend.
# STORAGE_DRIVER=s3
# S3_BUCKET=kintura
# Standard ist AWS. Für andere Dienste wie MinIO die Adresse angeben, oft auch S3_PATH_STYLE=true.
# S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
# S3_REGION=eu-central-1
# Ohne Schlüssel gilt die Rolle der Maschine (AWS IAM).
# S3_ACCESS_KEY=change-me
# S3_SECRET_KEY=change-me
# Ordner im Bucket, für mehrere Installationen in einem Bucket
# S3_PREFIX=kintura
# S3_PATH_STYLE=true
# Legt einen fehlenden Bucket an, etwa auf einem eigenen Dienst
# S3_CREATE_BUCKET=trueW