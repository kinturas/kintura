# Konfiguration des Kintura-Backends
# Die aktiven Werte entsprechen den Standardwerten aus backend/cmd/kintura/main.go.

# Adresse des HTTP-Servers
ADDR=:8080

# Ablage für die SQLite-Datenbank und lokale Dateien
DATA_DIR=data

# Datenbank: sqlite (Standard) oder postgres
# DB_DRIVER=postgres
# DATABASE_URL=postgres://kintura:change-me@localhost:5432/kintura

# Dateiablage: local (Standard, in DATA_DIR/files) oder s3. Der Bucket muss existieren
# und braucht keinen öffentlichen Zugriff, Dateien laufen immer durch das Backend.
# STORAGE_DRIVER=s3
# S3_BUCKET=kintura
# Standard ist AWS. Für andere Dienste wie MinIO die Adresse angeben, oft auch S3_PATH_STYLE=true.
# S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
# S3_REGION=eu-central-1
# Ohne Schlüssel gilt die Rolle der Maschine (AWS IAM).
# S3_ACCESS_KEY=change-me
# S3_SECRET_KEY=change-me
# Ordner im Bucket, für mehrere Installationen in einem Bucket
# S3_PREFIX=kintura
# S3_PATH_STYLE=true
# Legt einen fehlenden Bucket an, etwa auf einem eigenen Dienst
# S3_CREATE_BUCKET=true

# Basis für Links in Mails und Downloads
APP_URL=http://localhost:8080

# Erlaubter Ursprung der Web-App (im Betrieb auf die echte Adresse einschränken)
CORS_ORIGIN=*

# Vorgabe für die Zeitzone neuer Termine
# DEFAULT_TIMEZONE=Europe/Berlin

# API-Token für das Admin-Dashboard, mindestens 16 Zeichen. Er erlaubt ohne Mail
# die Anmeldung über /login/token als admin@kintura. Ohne gültigen Token sind
# Token-Anmeldung und Freischalten gesperrt.
# Erzeugen z. B. mit: openssl rand -hex 32
# ADMIN_API_KEY=change-me

# Mailserver: Ohne SMTP_HOST werden Mails samt Login-Code nur ins Server-Log
# geschrieben (nur für Entwicklung).
# Port 465 nutzt direktes TLS, andere Ports STARTTLS, sofern der Server es anbietet.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=kintura@example.com
# SMTP_PASS=change-me
# Standard für SMTP_FROM ist SMTP_USER
# SMTP_FROM=kintura@example.com
